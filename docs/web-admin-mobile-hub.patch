From 1b22a97a5970a9eec208553b3740029c01f9bf1b Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Fri, 11 Sep 2026 07:50:05 +0000
Subject: [PATCH] Add mobile admin hub back button for module navigation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On mobile browsers, opening an admin module left users stuck with no way
back to the main hub except logout. Add a sticky لوحة التحكم button and
module label in the header when viewing any module other than hub.
---
 assets/css/admin-mobile.css | 31 +++++++++++++++++++++++++++++++
 assets/css/admin-shell.css  | 30 ++++++++++++++++++++++++++++++
 assets/js/admin-shell.js    | 33 +++++++++++++++++++++++++++++++++
 pages/admin.html            |  6 +++---
 4 files changed, 97 insertions(+), 3 deletions(-)

diff --git a/assets/css/admin-mobile.css b/assets/css/admin-mobile.css
index d5f0143..8dc9ffc 100644
--- a/assets/css/admin-mobile.css
+++ b/assets/css/admin-mobile.css
@@ -328,6 +328,37 @@
     padding: 10px 14px !important;
   }
 
+  .admin-shell-mobile-bar {
+    display: flex !important;
+    flex-wrap: wrap !important;
+    gap: 8px !important;
+    width: 100% !important;
+    margin-top: 6px !important;
+  }
+
+  .admin-shell-hub-btn {
+    min-height: 44px !important;
+    flex: 0 0 auto !important;
+    padding: 10px 14px !important;
+  }
+
+  .admin-shell-module-label {
+    flex: 1 1 120px !important;
+    text-align: end !important;
+    font-size: 13px !important;
+    font-weight: 800 !important;
+    line-height: 1.5 !important;
+    color: #0f5f46 !important;
+  }
+
+  body.admin-shell-ready.admin-authenticated #admin-login-section {
+    position: sticky;
+    top: calc(52px + env(safe-area-inset-top, 0px));
+    z-index: 25;
+    background: #e8efe9;
+    margin-bottom: 6px !important;
+  }
+
   .admin-module-hub-grid,
   .admin-hub-grid {
     grid-template-columns: 1fr !important;
diff --git a/assets/css/admin-shell.css b/assets/css/admin-shell.css
index 32ffd5d..057f571 100644
--- a/assets/css/admin-shell.css
+++ b/assets/css/admin-shell.css
@@ -262,6 +262,24 @@ body.admin-shell-ready.admin-authenticated #admin-module-delegates:not(.admin-mo
   display: none;
 }
 
+.admin-shell-mobile-bar {
+  display: none;
+}
+
+.admin-shell-hub-btn {
+  min-height: 40px;
+  font-weight: 800;
+}
+
+.admin-shell-module-label {
+  flex: 1;
+  text-align: end;
+  font-size: 13px;
+  font-weight: 800;
+  color: #0f5f46;
+  line-height: 1.4;
+}
+
 @media (max-width: 900px) {
   body.admin-shell-ready.admin-authenticated .page {
     grid-template-columns: 1fr;
@@ -284,6 +302,18 @@ body.admin-shell-ready.admin-authenticated #admin-module-delegates:not(.admin-mo
   .admin-shell-mobile-toggle {
     display: inline-flex;
   }
+  .admin-shell-mobile-bar {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    width: 100%;
+    margin-top: 4px;
+  }
+  .admin-shell-mobile-bar.is-hub .admin-shell-module-label {
+    text-align: center;
+    color: #4b5563;
+    font-weight: 700;
+  }
   body.admin-shell-ready.admin-authenticated #admin-protected-sections,
   body.admin-shell-ready.admin-authenticated #bulk-name-audit-section,
   body.admin-shell-ready.admin-authenticated #admin-module-hub,
diff --git a/assets/js/admin-shell.js b/assets/js/admin-shell.js
index e293ad3..096f408 100644
--- a/assets/js/admin-shell.js
+++ b/assets/js/admin-shell.js
@@ -227,6 +227,8 @@
       nav.appendChild(btn);
     });
 
+    ensureMobileNavBar(header);
+
     // Mobile toggle in header nav
     if (header) {
       const navEl = header.querySelector("nav");
@@ -332,6 +334,36 @@
     else host.appendChild(section);
   }
 
+  function ensureMobileNavBar(header) {
+    if (!header || document.getElementById("admin-shell-mobile-bar")) return;
+    const bar = document.createElement("div");
+    bar.id = "admin-shell-mobile-bar";
+    bar.className = "admin-shell-mobile-bar";
+    bar.innerHTML =
+      '<button type="button" id="admin-shell-hub-btn" class="btn btn-primary btn-sm admin-shell-hub-btn">لوحة التحكم</button>' +
+      '<span id="admin-shell-module-label" class="admin-shell-module-label"></span>';
+    header.appendChild(bar);
+    const hubBtn = bar.querySelector("#admin-shell-hub-btn");
+    if (hubBtn) {
+      hubBtn.addEventListener("click", () => navigate("hub"));
+    }
+    updateMobileNavBar();
+  }
+
+  function updateMobileNavBar() {
+    const bar = document.getElementById("admin-shell-mobile-bar");
+    if (!bar) return;
+    const onHub = currentModule === "hub";
+    const hubBtn = document.getElementById("admin-shell-hub-btn");
+    const label = document.getElementById("admin-shell-module-label");
+    const mod = MODULES.find((m) => m.id === currentModule);
+    bar.classList.toggle("is-hub", onHub);
+    if (hubBtn) hubBtn.hidden = onHub;
+    if (label) {
+      label.textContent = onHub ? "اختر موديولًا للبدء" : mod ? mod.title : "";
+    }
+  }
+
   function ensureDelegatesHost() {
     // Host section only — UI filled by modules/admin-delegates-v2.js (Phase 2)
     if (document.getElementById("admin-module-delegates")) return;
@@ -435,6 +467,7 @@
       document.querySelectorAll(".admin-shell-nav-btn").forEach((btn) => {
         btn.classList.toggle("is-active", btn.dataset.module === mod.id);
       });
+      updateMobileNavBar();
     } finally {
       resumeBodyClassObserver();
       visibilityDepth -= 1;
