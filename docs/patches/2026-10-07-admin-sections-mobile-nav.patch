index 54e3f69..2d3c9dc 100644
--- a/assets/css/admin-mobile.css
+++ b/assets/css/admin-mobile.css
@@ -9,12 +9,19 @@
     overflow-x: hidden !important;
   }
 
-  body.admin-shell-ready.admin-authenticated,
-  body.admin-shell-ready.admin-authenticated .page {
+  body.admin-shell-ready.admin-authenticated {
     max-width: 100vw !important;
     overflow-x: hidden !important;
   }
 
+  /* Do NOT overflow-x:hidden on .page — it clipped the fixed «الأقسام» drawer
+     (sidebar was a .page descendant). Drawer is hosted on body when narrow; keep
+     page from creating a second clipping box. */
+  body.admin-shell-ready.admin-authenticated .page {
+    max-width: 100vw !important;
+    overflow-x: visible !important;
+  }
+
   .page {
     padding: 10px 10px 28px !important;
     max-width: 100% !important;
