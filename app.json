{
  "expo": {
    "name": "عائلة مطلق الزيدان",
    "slug": "alzidan-family-mobile",
    "version": "2.0.0",
    "scheme": "com.alzidan.family2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.alzidan.family2",
      "buildNumber": "55",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "يحتاج التطبيق للوصول إلى الصور والفيديو عند إرفاق وسائط مع مناسبة عائلية أو ذكرى.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.alzidan.family2",
      "adaptiveIcon": {
        "backgroundColor": "#F5EDD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "expo-sharing",
      "expo-image-picker",
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "8a6659eb-ef85-49b5-a8db-7b7be96b8c1f",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "AlzidanFamilyWidgetExtension",
                  "bundleIdentifier": "com.alzidan.family2.AlzidanFamilyWidgetExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.alzidan.family2"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "alshryhy"
  }
}
